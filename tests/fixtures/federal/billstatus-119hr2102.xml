    <summaries>
      <summary>
        <versionCode>00</versionCode>
        <actionDate>2025-03-14</actionDate>
        <actionDesc>Introduced in House</actionDesc>
        <updateDate>2026-08-31T18:42:18Z</updateDate>
        <text><![CDATA[<p><strong>Major Richard Star Act</strong></p><p>This bill allows a veteran with a combat-related disability to receive retirement pay, without reduction, concurrently with their disability compensation. This includes veterans with a combat-related disability and fewer than 20 years of creditable service. (Currently, veterans who receive combat-related special compensation and retirement pay are subject to an offset in retirement pay for concurrent receipt of such benefits.)</p>]]></text>
      </summary>
    </summaries>
