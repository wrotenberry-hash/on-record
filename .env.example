# On Record — server-side settings. Set these in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Turso (SQLite) database. Locally, leave TURSO_DATABASE_URL unset to use ./.data/on-record.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Supabase Auth: used only for editor sign-in (magic link). Server-side only.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Editor allowlist: comma-separated emails and/or Supabase user IDs. Empty = nobody can edit.
EDITOR_EMAILS=
EDITOR_USER_IDS=

# OpenAI Responses API (extraction and bilateral research)
OPENAI_API_KEY=
OPENAI_EXTRACT_MODEL=gpt-5.4-mini
OPENAI_RESEARCH_MODEL=gpt-5.5

# Unattended intake. CRON_SECRET is provided by Vercel Cron; AUTOMATION_TICK_SECRET is for manual POSTs.
CRON_SECRET=
AUTOMATION_TICK_SECRET=
AUTOMATION_DAILY_LIMIT=2

# Anonymous reading of /records and its APIs. Off unless "1".
PUBLIC_READ_ENABLED=
