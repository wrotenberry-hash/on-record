# On Record — server-side settings. Set these in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Turso (SQLite) database. Set the stable database by hand (preferred); the
# TURSO_* pair injected by the Vercel Marketplace integration is per-deployment
# and only a fallback. Locally, leave both unset to use ./.data/on-record.db
ON_RECORD_DATABASE_URL=
ON_RECORD_DATABASE_TOKEN=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Editor sign-in: a long random access key typed once at /login. Rotating it signs everyone out.
EDITOR_ACCESS_KEY=

# Reviewer identity recorded on attestations (first entry), and the editor allowlist. Empty = nobody can edit.
EDITOR_EMAILS=
EDITOR_USER_IDS=

# OpenAI Responses API (extraction and bilateral research)
OPENAI_API_KEY=
OPENAI_EXTRACT_MODEL=gpt-5.4-mini
OPENAI_RESEARCH_MODEL=gpt-5.5

# Unattended intake. CRON_SECRET is provided by Vercel Cron; AUTOMATION_TICK_SECRET is for manual POSTs.
CRON_SECRET=
AUTOMATION_TICK_SECRET=
AUTOMATION_DAILY_LIMIT=2

# Anonymous reading of /records and its APIs. Off unless "1".
PUBLIC_READ_ENABLED=
